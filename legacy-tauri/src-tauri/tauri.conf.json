{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NebulaSSH",
  "version": "2.0.0",
  "identifier": "com.nebulassh.client",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "NebulaSSH",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#0f0f17",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Thomas Schöpf",
    "shortDescription": "SSH-, SFTP- und Serial-Client",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
